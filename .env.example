# Copy to .env before running: cp .env.example .env
# The ONLY value you must set yourself is ANTHROPIC_API_KEY.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Fine to leave as-is for local development. Change all of these
# before deploying anywhere reachable from the internet.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpassword123
